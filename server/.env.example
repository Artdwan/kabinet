# Postgres. The `pg` driver is pure JavaScript, so no native build toolchain
# is needed — this is why the server moved off SQLite/better-sqlite3.
DATABASE_URL=postgresql://user:password@localhost:5432/kabinet

# Signs the 30-day auth tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=

# Seed the demo accounts (irina@demo / maksim@demo / parent@demo) on db:seed.
SEED_DEMO=false

PORT=4000

# Ключ для помощника (панель «Помощник» у преподавателя). Без него панель
# работает, но сообщает, что агент не подключён.
ANTHROPIC_API_KEY=
# Необязательно: другой адрес API, если запросы идут через прокси или шлюз.
# ANTHROPIC_BASE_URL=https://api.anthropic.com
